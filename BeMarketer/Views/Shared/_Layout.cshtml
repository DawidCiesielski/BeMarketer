<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BeMarketer</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BeMarketer.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@@latest/tabler-icons.min.css" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div style="display:flex; align-items:center; gap:1.5rem;">
                <a class="navbar-brand" href="/">Be<span>Marketer</span></a>
                @{
                    var c = ViewContext.RouteData.Values["Controller"]?.ToString();
                    var a = ViewContext.RouteData.Values["Action"]?.ToString();
                }
                <ul class="navbar-nav flex-row">
                    <li class="nav-item">
                        <a class="nav-link @(c == "Home" && a == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                            <i class="ti ti-home"></i> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(c == "Home" && a == "Privacy" ? "active" : "")" asp-controller="Home" asp-action="Privacy">
                            <i class="ti ti-lock"></i> Privacy
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(c == "Leads" ? "active" : "")" asp-controller="Leads" asp-action="Index">
                            <i class="ti ti-users"></i> Leads
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(c == "Statistics" ? "active" : "")" asp-controller="Statistics" asp-action="Index">
                            <i class="ti ti-chart-bar"></i> Stats
                        </a>
                    </li>
                </ul>
            </div>
            <div class="navbar-right">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    var email = User.Identity.Name ?? "";
                    var initials = email.Length >= 2 ? email.Substring(0, 2).ToUpper() : "?";

                    <div class="navbar-avatar">@initials</div>
                    <span class="navbar-email">@email</span>
                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                        <button type="submit" class="navbar-logout" style="border:1px solid rgba(0,0,0,0.15); cursor:pointer;">Logout</button>
                    </form>
                }
                else
                {
                    <a class="navbar-logout" asp-area="Identity" asp-page="/Account/Login">Login</a>
                    <a class="navbar-logout" asp-area="Identity" asp-page="/Account/Register">Register</a>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - BeMarketer - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
