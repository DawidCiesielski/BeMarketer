@model BeMarketer.ViewModels.StatisticsViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Stats";
}

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<div class="container py-4">

    <div class="stats-header">
        <div>
            <h1>Stats</h1>
            <p class="period-badge">
                @Model.PeriodLabel
                @if (Model.HasComparison)
                {
                    <text>&nbsp;vs&nbsp;@Model.ComparePeriodLabel</text>
                }
            </p>
        </div>
    </div>

    <form method="get" asp-action="Index">
        <div class="row g-2 align-items-center mb-3">
            <div class="col-auto">
                <select name="year" class="form-select">
                    @foreach (var y in Model.AvailableYears)
                    {
                        if (Model.SelectedYear == y)
                        {
                            <option value="@y" selected="selected">@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </div>

            <div class="col-auto">
                <select name="month" class="form-select">
                    <option value="">— Whole year —</option>
                    @for (int m = 1; m <= 12; m++)
                    {
                        var mName = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m);
                        if (Model.SelectedMonth == m)
                        {
                            <option value="@m" selected="selected">@mName</option>
                        }
                        else
                        {
                            <option value="@m">@mName</option>
                        }
                    }
                </select>
            </div>

            <div class="col-auto">
                <select name="compareYear" class="form-select">
                    <option value="">—</option>
                    @foreach (var y in Model.AvailableYears)
                    {
                        if (Model.CompareYear == y)
                        {
                            <option value="@y" selected="selected">@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </div>

            <div class="col-auto">
                <select name="compareMonth" class="form-select">
                    <option value="">— Whole year —</option>
                    @for (int m = 1; m <= 12; m++)
                    {
                        var mName = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m);
                        if (Model.CompareMonth == m)
                        {
                            <option value="@m" selected="selected">@mName</option>
                        }
                        else
                        {
                            <option value="@m">@mName</option>
                        }
                    }
                </select>
            </div>

            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Apply</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">Reset</a>
            </div>
        </div>
    </form>

    @{
        var curr = Model.CurrentPeriodStats;
        var comp = Model.ComparePeriodStats;

        string DeltaHtml(int currVal, int? compVal)
        {
            if (compVal == null) return "";
            var diff = currVal - compVal.Value;
            if (diff == 0) return "<span class='kpi-delta'>= Without change</span>";
            var sign = diff > 0 ? "+" : "";
            var cls = diff > 0 ? "up" : "down";
            var arrow = diff > 0 ? "▲" : "▼";
            return $"<span class='kpi-delta {cls}'>{arrow} {sign}{diff} vs {Model.ComparePeriodLabel}</span>";
        }

        string DeltaDoubleHtml(double currVal, double? compVal)
        {
            if (compVal == null) return "";
            var diff = Math.Round(currVal - compVal.Value, 1);
            if (diff == 0) return "<span class='kpi-delta'>= Without change</span>";
            var sign = diff > 0 ? "+" : "";
            var cls = diff > 0 ? "up" : "down";
            var arrow = diff > 0 ? "▲" : "▼";
            return $"<span class='kpi-delta {cls}'>{arrow} {sign}{diff}% vs {Model.ComparePeriodLabel}</span>";
        }
    }

    <h4>General Statistics</h4>
    <table class="table table-bordered mb-4">
        <thead>
            <tr>
                <th>Metric</th>
                <th>Period (@Model.PeriodLabel)</th>
                @if (Model.ComparePeriodStats != null)
                {
                    <th>Comparison (@Model.ComparePeriodLabel)</th>
                    <th>Difference</th>
                }
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>All leads</td>
                <td>@curr?.TotalLeads</td>
                @if (Model.ComparePeriodStats != null)
                {
                    <td>@comp?.TotalLeads</td>
                    <td>@(curr.TotalLeads - (comp?.TotalLeads ?? 0))</td>
                }
            </tr>
            <tr>
                <td>New</td>
                <td>@curr?.NewLeads</td>
                @if (Model.ComparePeriodStats != null)
                {
                    <td>@comp?.NewLeads</td>
                    <td>@(curr.NewLeads - (comp?.NewLeads ?? 0))</td>
                }
            </tr>
            <tr>
                <td>Contacted</td>
                <td>@curr?.ContactedLeads</td>
                @if (Model.ComparePeriodStats != null)
                {
                    <td>@comp?.ContactedLeads</td>
                    <td>@(curr.ContactedLeads - (comp?.ContactedLeads ?? 0))</td>
                }
            </tr>
            <tr>
                <td>Qualified</td>
                <td>@curr?.QualifiedLeads</td>
                @if (Model.ComparePeriodStats != null)
                {
                    <td>@comp?.QualifiedLeads</td>
                    <td>@(curr.QualifiedLeads - (comp?.QualifiedLeads ?? 0))</td>
                }
            </tr>
            <tr>
                <td>Lost</td>
                <td>@curr?.LostLeads</td>
                @if (Model.ComparePeriodStats != null)
                {
                    <td>@comp?.LostLeads</td>
                    <td>@(curr.LostLeads - (comp?.LostLeads ?? 0))</td>
                }
            </tr>
            <tr>
                <td>Conversion (%)</td>
                <td>@String.Format("{0:0.0}", curr?.ConversionRate ?? 0)</td>
                @if (Model.ComparePeriodStats != null)
                {
                    <td>@String.Format("{0:0.0}", comp?.ConversionRate ?? 0)</td>
                    <td>@String.Format("{0:+0.0;-0.0;0.0}", (curr?.ConversionRate ?? 0) - (comp?.ConversionRate ?? 0))</td>
                }
            </tr>
        </tbody>
    </table>

    <div class="top-section row mb-4">
        <div class="col-md-4">
            @if (Model.TopEmployee != null)
            {
                <table class="table table-bordered">
                    <thead>
                        <tr><th colspan="2">Top Employee</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Employee</td><td>@Model.TopEmployee.UserName</td></tr>
                        <tr><td>Leads</td><td>@Model.TopEmployee.LeadCount</td></tr>
                        <tr><td>Qualified</td><td>@Model.TopEmployee.QualifiedLeads</td></tr>
                        <tr><td>Lost</td><td>@Model.TopEmployee.LostLeads</td></tr>
                        <tr><td>Conversion (%)</td><td>@String.Format("{0:0.0}", Model.TopEmployee.ConversionRate)</td></tr>
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-secondary">No employee data</div>
            }
        </div>
    </div>

    @if (Model.EmployeeRanking.Any())
    {
        <div class="ranking-section">
            <div class="section-title">Employee Ranking</div>
            <div class="chart-card">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Employee</th>
                            <th>Leads</th>
                            <th>New</th>
                            <th>Contact</th>
                            <th>Qualified</th>
                            <th>Lost</th>
                            <th>Conversion</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rank = 1;
                        }
                        @foreach (var emp in Model.EmployeeRanking)
                        {
                            var rankCls = rank == 1 ? "gold" : rank == 2 ? "silver" : rank == 3 ? "bronze" : "";
                            var safeCount = emp.LeadCount > 0 ? emp.LeadCount : 1;
                            <tr>
                                <td class="rank-num @rankCls">@rank</td>
                                <td>@emp.UserName</td>
                                <td><strong>@emp.LeadCount</strong></td>
                                <td><span class="status-pill pill-new">@emp.NewLeads</span></td>
                                <td><span class="status-pill pill-contacted">@emp.ContactedLeads</span></td>
                                <td><span class="status-pill pill-qualified">@emp.QualifiedLeads</span></td>
                                <td><span class="status-pill pill-lost">@emp.LostLeads</span></td>
                                <td style="color:var(--accent)">@emp.ConversionRate%</td>
                            </tr>
                            rank++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

@section Scripts {
<script>
(function () {
    var hasComparison = @(Model.HasComparison ? "true" : "false");

    @if (Model.SelectedMonth.HasValue)
    {
        var daysInMonth      = DateTime.DaysInMonth(Model.SelectedYear, Model.SelectedMonth.Value);
        var dailyDict        = Model.DailyData.ToDictionary(d => d.Date.Day, d => d.Count);
        var compareDailyDict = Model.CompareDailyData.ToDictionary(d => d.Date.Day, d => d.Count);

        @:var labels      = Array.from({length: @daysInMonth}, (_, i) => String(i + 1));
        @:var currentData = [@(string.Join(",", Enumerable.Range(1, daysInMonth).Select(d => dailyDict.GetValueOrDefault(d, 0))))];
        @:var compareData = [@(string.Join(",", Enumerable.Range(1, daysInMonth).Select(d => compareDailyDict.GetValueOrDefault(d, 0))))];
    }
    else
    {
        var monthNames         = CultureInfo.CurrentCulture.DateTimeFormat.AbbreviatedMonthNames.Take(12).ToArray();
        var monthlyDict        = Model.MonthlyData.ToDictionary(m => m.Month, m => m.Count);
        var compareMonthlyDict = Model.CompareMonthlyData.ToDictionary(m => m.Month, m => m.Count);

        @:var labels      = [@(string.Join(",", monthNames.Select(m => $"'{m}'")))];
        @:var currentData = [@(string.Join(",", Enumerable.Range(1, 12).Select(m => monthlyDict.GetValueOrDefault(m, 0))))];
        @:var compareData = [@(string.Join(",", Enumerable.Range(1, 12).Select(m => compareMonthlyDict.GetValueOrDefault(m, 0))))];
    }

</script>
}